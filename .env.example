# ==============================
# Banco de Dados (PostgreSQL via Docker)
# ==============================
POSTGRES_USER=weeklies_user
POSTGRES_PASSWORD=troque-por-uma-senha-segura
POSTGRES_DB=weeklies_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ==============================
# pgAdmin 4 (Interface Visual do Banco)
# ==============================
PGADMIN_DEFAULT_EMAIL=admin@weeklies.com
PGADMIN_DEFAULT_PASSWORD=troque-por-uma-senha-segura
PGADMIN_PORT=5050

# ==============================
# Autenticação JWT
# ==============================
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-uma-chave-segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================
# Redis (OTP / Cache)
# ==============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
OTP_EXPIRE_MINUTES=15

# ==============================
# CORS 
# ==============================
CORS_ORIGINS=http://localhost:5173,http://192.168.1.12:5173

# ==============================
# E-mail (SMTP — Gmail App Password)
# ==============================
# Para gerar uma App Password no Gmail:
# 1. Ative a verificação em duas etapas na conta Google
# 2. Acesse: https://myaccount.google.com/apppasswords
# 3. Gere uma senha de aplicativo para "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua-app-password-aqui
SMTP_FROM_NAME=LearningLab
SMTP_FROM_EMAIL=seuemail@gmail.com
SMTP_USE_TLS=True
